generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id        String   @id @default(cuid())
  nameTr    String
  nameEn    String
  imageUrl  String
  link      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Service {
  id          String   @id @default(cuid())
  titleTr     String
  titleEn     String
  descriptionTr String?
  descriptionEn String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model Event {
  id            String       @id @default(cuid())
  slug          String       @unique
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  venueTr       String?
  venueEn       String?
  eventDate     DateTime?
  sortOrder     Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  media         EventMedia[]

  @@index([active, sortOrder])
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  url       String
  type      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

model Todo {
  id          String   @id @default(cuid())
  title       String
  notes       String?
  priority    String   @default("P3")
  dueDate     DateTime @default(now())
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([priority, completed, dueDate])
}

model SiteSettings {
  id                  String   @id @default("default")
  heroEyebrowTr       String
  heroEyebrowEn       String
  heroTitleTr         String
  heroTitleEn         String
  heroDescriptionTr   String
  heroDescriptionEn   String
  phone               String
  email               String
  addressTr           String
  addressEn           String
  seoTitleTr          String
  seoTitleEn          String
  seoDescriptionTr    String
  seoDescriptionEn    String
  updatedAt           DateTime @updatedAt
}

/// Single editable application form. The id is always "default".
model ApplicationForm {
  id            String   @id @default("default")
  titleTr       String
  titleEn       String
  descriptionTr String?
  descriptionEn String?
  isOpen        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions   ApplicationQuestion[]
  submissions ApplicationSubmission[]
}

model ApplicationQuestion {
  id        String   @id @default(cuid())
  formId    String   @default("default")
  type      String
  labelTr   String
  labelEn   String
  helpTr    String?
  helpEn    String?
  required  Boolean  @default(false)
  options   Json?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form ApplicationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, sortOrder])
}

model ApplicationSubmission {
  id            String   @id @default(cuid())
  formId        String   @default("default")
  submittedAt   DateTime @default(now())
  locale        String   @default("tr")
  submissionKey String?  @unique

  form    ApplicationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]

  @@index([formId, submittedAt])
}

/// Snapshot table. No foreign key to ApplicationQuestion on purpose:
/// editing or deleting a question must never rewrite submitted answers.
model ApplicationAnswer {
  id              String   @id @default(cuid())
  submissionId    String
  questionId      String?
  questionLabelTr String
  questionLabelEn String
  questionType    String
  value           Json
  displayTr       String
  displayEn       String
  sortOrder       Int      @default(0)

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, sortOrder])
  @@index([questionId])
}
