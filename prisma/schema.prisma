generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id        String   @id @default(cuid())
  nameTr    String
  nameEn    String
  imageUrl  String
  link      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Service {
  id          String   @id @default(cuid())
  titleTr     String
  titleEn     String
  descriptionTr String?
  descriptionEn String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model Event {
  id            String       @id @default(cuid())
  slug          String       @unique
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  venueTr       String?
  venueEn       String?
  eventDate     DateTime?
  sortOrder     Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  media         EventMedia[]

  @@index([active, sortOrder])
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  url       String
  type      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

model Todo {
  id          String   @id @default(cuid())
  title       String
  notes       String?
  priority    String   @default("P3")
  dueDate     DateTime @default(now())
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([priority, completed, dueDate])
}

model SiteSettings {
  id                  String   @id @default("default")
  heroEyebrowTr       String
  heroEyebrowEn       String
  heroTitleTr         String
  heroTitleEn         String
  heroDescriptionTr   String
  heroDescriptionEn   String
  phone               String
  email               String
  addressTr           String
  addressEn           String
  seoTitleTr          String
  seoTitleEn          String
  seoDescriptionTr    String
  seoDescriptionEn    String
  updatedAt           DateTime @updatedAt
}
